# card42 card-side CAPs: compile once, convert twice (release + debug).
#
# `make` builds BOTH variants.  The release CAP is the canonical deliverable
# name and the debug CAP carries a -debug suffix; both land flat in
# $(DELIVERABLES).  CAP_MODE (config/build.mk) only selects which variant the
# deploy/test targets consume -- it never appears in a target name, so
# `make`/`make card` are mode-independent.
#
# The converter's -debug flag (line numbers + local-variable tables, ~20-25%
# larger) is the only difference between the two conversions; they reuse the
# same `javac -g` classes and produce byte-identical .exp files.

CAP_SUFFIX := $(if $(filter release,$(CAP_MODE)),,-debug)

# --- Deliverables (flat) ----------------------------------------------------
COMMON_CAP       := $(DELIVERABLES)/card42-common.cap
COMMON_EXP       := $(DELIVERABLES)/card42-common.exp
COMMON_CAP_DEBUG := $(DELIVERABLES)/card42-common-debug.cap
COMMON_EXP_DEBUG := $(DELIVERABLES)/card42-common-debug.exp
EMV_CAP          := $(DELIVERABLES)/card42-emv.cap
EMV_EXP          := $(DELIVERABLES)/card42-emv.exp
EMV_CAP_DEBUG    := $(DELIVERABLES)/card42-emv-debug.cap
EMV_EXP_DEBUG    := $(DELIVERABLES)/card42-emv-debug.exp
EMRTD_CAP        := $(DELIVERABLES)/card42-emrtd.cap
EMRTD_EXP        := $(DELIVERABLES)/card42-emrtd.exp
EMRTD_CAP_DEBUG  := $(DELIVERABLES)/card42-emrtd-debug.cap
EMRTD_EXP_DEBUG  := $(DELIVERABLES)/card42-emrtd-debug.exp

# Variant selected by CAP_MODE for deploy/test.
COMMON_CAP_SEL := $(DELIVERABLES)/card42-common$(CAP_SUFFIX).cap
EMV_CAP_SEL    := $(DELIVERABLES)/card42-emv$(CAP_SUFFIX).cap
EMRTD_CAP_SEL  := $(DELIVERABLES)/card42-emrtd$(CAP_SUFFIX).cap

# --- Compile output (one javac pass per module, shared by both modes) ------
COMMON_BIN   := $(BUILD_DIR)/card/common/bin
EMV_BIN      := $(BUILD_DIR)/card/emv/bin
EMRTD_BIN    := $(BUILD_DIR)/card/emrtd/bin
COMMON_STAMP := $(COMMON_BIN)/.compiled
EMV_STAMP    := $(EMV_BIN)/.compiled
EMRTD_STAMP  := $(EMRTD_BIN)/.compiled

# --- Converter config (one per module and mode; CONF_RELEASE has no -debug) --
COMMON_CONF         := $(BUILD_DIR)/card42common.conf
COMMON_CONF_RELEASE := $(BUILD_DIR)/card42common-release.conf
EMV_CONF            := $(BUILD_DIR)/card42-emv.conf
EMV_CONF_RELEASE    := $(BUILD_DIR)/card42-emv-release.conf
EMRTD_CONF          := $(BUILD_DIR)/card42-emrtd.conf
EMRTD_CONF_RELEASE  := $(BUILD_DIR)/card42-emrtd-release.conf

# --- Raw converter output directories ---------------------------------------
COMMON_RAW         := $(OUT_DIR)/release/card42common/card42/common/javacard
COMMON_RAW_DEBUG   := $(OUT_DIR)/debug/card42common/card42/common/javacard
EMV_RAW            := $(OUT_DIR)/release/card42/emv/javacard
EMV_RAW_DEBUG      := $(OUT_DIR)/debug/card42/emv/javacard
EMRTD_RAW          := $(OUT_DIR)/release/card42/emrtd/javacard
EMRTD_RAW_DEBUG    := $(OUT_DIR)/debug/card42/emrtd/javacard

# --- Generated test switch --------------------------------------------------
# Runs on every invocation (FORCE) but only rewrites the file when the value
# actually changed, so it does not force a CAP rebuild when nothing changed.
$(GEN_SRC): FORCE
	@mkdir -p $(dir $@)
	@if [ "$(TEST_CONTACTLESS)" = "1" ]; then v=true; else v=false; fi; \
	if [ ! -f $@ ] || ! grep -q "ALLOW_CONTACTLESS_ON_CONTACT = $$v;" $@; then \
	  echo "generating $@ (ALLOW_CONTACTLESS_ON_CONTACT=$$v)"; \
	  { \
	    echo 'package card42.emv;'; \
	    echo ''; \
	    echo '/* Generated by the Makefile.  Do not edit; see docs/specs/common/architecture.md §7. */'; \
	    echo 'public final class BuildConfig {'; \
	    echo '    /** Test build only: allow CONTACTLESS role instances on the contact interface. */'; \
	    echo "    public static final boolean ALLOW_CONTACTLESS_ON_CONTACT = $$v;"; \
	    echo ''; \
	    echo '    private BuildConfig() {}'; \
	    echo '}'; \
	  } > $@; \
	fi

.PHONY: FORCE
FORCE:

# --- Converter config files -------------------------------------------------
# The "$@" comparison keeps a single printf per module; the -debug line and the
# per-mode -d output dir are the only mode-dependent parts.
$(COMMON_CONF) $(COMMON_CONF_RELEASE): Makefile $(CONFIG_FILES)
	@mkdir -p $(BUILD_DIR)
	@if [ "$@" = "$(COMMON_CONF)" ]; then m=debug; d=-debug; else m=release; d=; fi; \
	printf '%s\n' \
	  '-classdir card/common/bin' \
	  '-exportpath $(abspath $(GPAPI)/exports23)' \
	  '-out CAP EXP JCA' \
	  "-d out/$$m/card42common" \
	  "$$d" \
	  '-target $(JC_TARGET)' \
	  '$(COMMON_PACKAGE_NAME)' \
	  '$(COMMON_PACKAGE_AID) $(COMMON_VERSION)' | sed '/^$$/d' > $@

$(EMV_CONF) $(EMV_CONF_RELEASE): Makefile $(CONFIG_FILES)
	@mkdir -p $(BUILD_DIR)
	@if [ "$@" = "$(EMV_CONF)" ]; then m=debug; d=-debug; else m=release; d=; fi; \
	printf '%s\n' \
	  '-classdir card/emv/bin' \
	  "-exportpath $(abspath $(GPAPI)/exports23):$(abspath $(OUT_DIR))/$$m/card42common" \
	  '-applet $(APPLET_AID) $(APPLET_CLASS)' \
	  '-applet $(DIRECTORY_AID) $(DIRECTORY_CLASS)' \
	  '-out CAP EXP JCA' \
	  "-d out/$$m" \
	  "$$d" \
	  '-target $(JC_TARGET)' \
	  '$(PACKAGE_NAME)' \
	  '$(PACKAGE_AID) $(PACKAGE_VERSION)' | sed '/^$$/d' > $@

$(EMRTD_CONF) $(EMRTD_CONF_RELEASE): Makefile $(CONFIG_FILES)
	@mkdir -p $(BUILD_DIR)
	@if [ "$@" = "$(EMRTD_CONF)" ]; then m=debug; d=-debug; else m=release; d=; fi; \
	printf '%s\n' \
	  '-classdir card/emrtd/bin' \
	  "-exportpath $(abspath $(GPAPI)/exports23):$(abspath $(OUT_DIR))/$$m/card42common" \
	  '-applet $(EMRTD_AID) $(EMRTD_CLASS)' \
	  '-out CAP EXP JCA' \
	  "-d out/$$m" \
	  "$$d" \
	  '-target $(JC_TARGET)' \
	  '$(EMRTD_PACKAGE_NAME)' \
	  '$(EMRTD_PACKAGE_AID) 1.0' | sed '/^$$/d' > $@

# --- Compile (once per module) ----------------------------------------------
$(COMMON_STAMP): $(CARD_COMMON_SRC)
	@mkdir -p $(COMMON_BIN)
	$(JAVAC) -g -d $(COMMON_BIN) \
	  -cp $(JC_TOOLS_LIB)/api_classic-$(JC_API_VERSION).jar:$(GPAPI)/gpapi-globalplatform.jar \
	  --release $(JAVAC_RELEASE) -Xlint:-options -encoding UTF-8 \
	  $(CARD_COMMON_SRC)
	@touch $@

$(EMV_STAMP): $(CARD_EMV_SRC) $(COMMON_STAMP)
	@mkdir -p $(EMV_BIN)
	$(JAVAC) -g -d $(EMV_BIN) \
	  -cp $(JC_TOOLS_LIB)/api_classic-$(JC_API_VERSION).jar:$(GPAPI)/gpapi-globalplatform.jar:$(COMMON_BIN) \
	  --release $(JAVAC_RELEASE) -Xlint:-options -encoding UTF-8 \
	  $(CARD_EMV_SRC)
	@touch $@

$(EMRTD_STAMP): $(CARD_EMRTD_SRC) $(COMMON_STAMP)
	@if [ -n "$(CARD_EMRTD_SRC)" ]; then \
	  mkdir -p $(EMRTD_BIN); \
	  $(JAVAC) -g -d $(EMRTD_BIN) \
	    -cp $(JC_TOOLS_LIB)/api_classic-$(JC_API_VERSION).jar:$(GPAPI)/gpapi-globalplatform.jar:$(COMMON_BIN) \
	    --release $(JAVAC_RELEASE) -Xlint:-options -encoding UTF-8 \
	    $(CARD_EMRTD_SRC) || exit 1; \
	  touch $@; \
	fi

# --- Convert + flatten ------------------------------------------------------
# Grouped targets: the recipe runs once and produces both the CAP and its .exp.
$(COMMON_CAP) $(COMMON_EXP) &: $(COMMON_STAMP) $(COMMON_CONF_RELEASE)
	@mkdir -p $(DELIVERABLES)
	rm -rf $(OUT_DIR)/release/card42common
	cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42common-release.conf
	cp $(COMMON_RAW)/common.cap $(COMMON_CAP)
	cp $(COMMON_RAW)/common.exp $(COMMON_EXP)

$(COMMON_CAP_DEBUG) $(COMMON_EXP_DEBUG) &: $(COMMON_STAMP) $(COMMON_CONF)
	@mkdir -p $(DELIVERABLES)
	rm -rf $(OUT_DIR)/debug/card42common
	cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42common.conf
	cp $(COMMON_RAW_DEBUG)/common.cap $(COMMON_CAP_DEBUG)
	cp $(COMMON_RAW_DEBUG)/common.exp $(COMMON_EXP_DEBUG)

$(EMV_CAP) $(EMV_EXP) &: $(EMV_STAMP) $(COMMON_CAP) $(EMV_CONF_RELEASE)
	@mkdir -p $(DELIVERABLES)
	rm -rf $(OUT_DIR)/release/card42/emv
	cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42-emv-release.conf
	cp $(EMV_RAW)/emv.cap $(EMV_CAP)
	cp $(EMV_RAW)/emv.exp $(EMV_EXP)

$(EMV_CAP_DEBUG) $(EMV_EXP_DEBUG) &: $(EMV_STAMP) $(COMMON_CAP_DEBUG) $(EMV_CONF)
	@mkdir -p $(DELIVERABLES)
	rm -rf $(OUT_DIR)/debug/card42/emv
	cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42-emv.conf
	cp $(EMV_RAW_DEBUG)/emv.cap $(EMV_CAP_DEBUG)
	cp $(EMV_RAW_DEBUG)/emv.exp $(EMV_EXP_DEBUG)

$(EMRTD_CAP) $(EMRTD_EXP) &: $(EMRTD_STAMP) $(COMMON_CAP) $(EMRTD_CONF_RELEASE)
	@if [ -n "$(CARD_EMRTD_SRC)" ]; then \
	  mkdir -p $(DELIVERABLES); \
	  rm -rf $(OUT_DIR)/release/card42/emrtd; \
	  ( cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42-emrtd-release.conf ); \
	  cp $(EMRTD_RAW)/emrtd.cap $(EMRTD_CAP); \
	  cp $(EMRTD_RAW)/emrtd.exp $(EMRTD_EXP); \
	fi

$(EMRTD_CAP_DEBUG) $(EMRTD_EXP_DEBUG) &: $(EMRTD_STAMP) $(COMMON_CAP_DEBUG) $(EMRTD_CONF)
	@if [ -n "$(CARD_EMRTD_SRC)" ]; then \
	  mkdir -p $(DELIVERABLES); \
	  rm -rf $(OUT_DIR)/debug/card42/emrtd; \
	  ( cd $(BUILD_DIR) && JAVA_HOME="$(JAVA_HOME)" $(CONVERTER) -config card42-emrtd.conf ); \
	  cp $(EMRTD_RAW_DEBUG)/emrtd.cap $(EMRTD_CAP_DEBUG); \
	  cp $(EMRTD_RAW_DEBUG)/emrtd.exp $(EMRTD_EXP_DEBUG); \
	fi

# --- Aggregates -------------------------------------------------------------
.PHONY: card card-common card-emv card-emrtd cap classes convert verify

# card-common/card-emv/card-emrtd build both variants of one module; `card`
# builds all three (and thus the two full sets).
card: card-common card-emv card-emrtd
card-common: $(COMMON_CAP) $(COMMON_CAP_DEBUG)
card-emv: $(EMV_CAP) $(EMV_CAP_DEBUG)
card-emrtd: $(EMRTD_CAP) $(EMRTD_CAP_DEBUG)
cap: card
classes: card
convert: card

# Verify every export file (release + debug; the .exp content is identical).
verify: card
	@for exp in $(COMMON_EXP) $(EMV_EXP) $(EMRTD_EXP) \
	            $(COMMON_EXP_DEBUG) $(EMV_EXP_DEBUG) $(EMRTD_EXP_DEBUG); do \
	  if [ -f "$$exp" ]; then \
	    JAVA_HOME="$(JAVA_HOME)" $(VERIFYEXP) $(abspath $$exp) || exit 1; \
	  fi; \
	done
